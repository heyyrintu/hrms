// dropping a table is irreversible, but do not assume the feature exists.
model WebhookLog {
  id           String           @id @default(uuid())
  tenantId     String
  webhookId    String
  event        String
  payload      Json
  status       WebhookLogStatus
  httpStatus   Int?
  responseBody String?          @db.Text
  errorMessage String?          @db.Text
  attemptCount Int              @default(1)
  triggeredAt  DateTime         @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([webhookId])
  @@index([triggeredAt])
  @@map("webhook_logs")
}

// ============================================
// EXIT / SEPARATION MANAGEMENT
// ============================================

enum SeparationType {
  RESIGNATION
  TERMINATION
  RETIREMENT
  END_OF_CONTRACT
  MUTUAL_SEPARATION
  ABSCONDING
}

enum SeparationStatus {
  INITIATED
  NOTICE_PERIOD
  CLEARANCE_PENDING
  COMPLETED
  CANCELLED
}

model Separation {
  id              String           @id @default(uuid())
  tenantId        String
  employeeId      String
  type            SeparationType
  status          SeparationStatus @default(INITIATED)
  reason          String?          @db.Text
  initiatedDate   DateTime         @default(now())
  lastWorkingDate DateTime?
  noticePeriodDays Int             @default(0)
  isNoticePeriodWaived Boolean     @default(false)
  exitInterviewDone Boolean        @default(false)
  exitInterviewNotes String?       @db.Text
  clearanceNotes  String?          @db.Text
  processedBy     String?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  employee  Employee @relation("SeparationEmployee", fields: [employeeId], references: [id])
  processor Employee? @relation("SeparationProcessedBy", fields: [processedBy], references: [id])
  settlement Settlement?

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@map("separations")
}

// ============================================
// INDIAN STATUTORY PAYROLL
// ============================================
//
// Rates, thresholds and slabs live in the database rather than in code because
// they change most years and several vary by state. The seed ships values
// current for FY 2025-26; verify them against the latest notifications before
// running a real payroll, and update the rows rather than the source when they
// change.

enum TaxRegime {
  OLD
  NEW
}

/// Per-tenant switches and rates for the statutory deductions.
model StatutoryConfig {
  id       String @id @default(uuid())
  tenantId String @unique

  // ---- EPF (Employees Provident Funds Act, 1952) ----
  pfEnabled      Boolean @default(true)
  /// Employee share, percent of PF wages (Basic + DA).
  pfEmployeeRate Decimal @default(12) @db.Decimal(5, 2)
  /// Employer share, percent of PF wages. EPS is carved out of this, not added.
  pfEmployerRate Decimal @default(12) @db.Decimal(5, 2)
  /// Pension share, percent of PF wages capped at the ceiling.
  epsRate        Decimal @default(8.33) @db.Decimal(5, 2)
  /// Statutory wage ceiling. EPS is always capped at this.
  pfWageCeiling  Decimal @default(15000) @db.Decimal(12, 2)
  /// Whether employee and employer PF are also capped at the ceiling. Many
  /// employers contribute on full wages instead; that is a policy choice.
  applyPfCeiling Boolean @default(true)
  /// EDLI, employer only, percent of capped PF wages.
  edliRate       Decimal @default(0.5) @db.Decimal(5, 2)
  /// EPF administration charges, employer only, percent of PF wages.
  pfAdminRate    Decimal @default(0.5) @db.Decimal(5, 2)
  /// Monthly minimum for administration charges.
  pfAdminMinimum Decimal @default(500) @db.Decimal(12, 2)

  // ---- ESI (Employees State Insurance Act, 1948) ----
  esiEnabled      Boolean @default(true)
  esiEmployeeRate Decimal @default(0.75) @db.Decimal(5, 2)
  esiEmployerRate Decimal @default(3.25) @db.Decimal(5, 2)
  /// Monthly gross at or below which an employee is covered.
  esiWageLimit    Decimal @default(21000) @db.Decimal(12, 2)

  // ---- Professional tax (state levy) ----
  ptEnabled Boolean @default(true)
  /// Which state's slab table applies. Slabs live in ProfessionalTaxSlab.
  ptState   String? @db.VarChar(50)
  /// Calendar months in which the state collects professional tax. Empty means
  /// every month, which is what most states do and what this did before the
  /// column existed. Tamil Nadu and others collect half-yearly.
  ptMonths  Int[]   @default([])

  // ---- Labour Welfare Fund (state levy) ----
  lwfEnabled        Boolean @default(false)
  lwfEmployeeAmount Decimal @default(0) @db.Decimal(10, 2)
  lwfEmployerAmount Decimal @default(0) @db.Decimal(10, 2)
  /// Calendar months (1-12) in which LWF is deducted. Most states are
  /// half-yearly or annual rather than monthly.
  lwfMonths         Int[]   @default([])

  // ---- Gratuity (Payment of Gratuity Act, 1972) ----
  gratuityEnabled Boolean @default(true)
  /// Days of wages per completed year. The Act says 15.
  gratuityDaysPerYear Decimal @default(15) @db.Decimal(5, 2)
  /// Days treated as a month's wages. The Act says 26 for covered establishments.
  gratuityMonthDays Decimal @default(26) @db.Decimal(5, 2)
  /// Completed years of service before any gratuity is payable.
  gratuityMinYears Decimal @default(5) @db.Decimal(5, 2)
  /// Lifetime exemption ceiling under section 10(10).
  gratuityExemptionCap Decimal @default(2000000) @db.Decimal(12, 2)

  // ---- Leave encashment on exit ----
  leaveEncashmentEnabled Boolean @default(true)
  /// Days treated as a month for valuing an encashed day.
  encashmentMonthDays Decimal @default(30) @db.Decimal(5, 2)
  /// Lifetime ceiling on the section 10(10AA) exemption for a non-government
  /// employee. Raised to twenty-five lakh with effect from FY 2023-24.
  encashmentExemptionCap Decimal @default(2500000) @db.Decimal(12, 2)
  /// Days of leave per completed year the exemption recognises. The section
  /// says 30, whatever the employer's own leave rules allow.
  encashmentExemptDaysPerYear Decimal @default(30) @db.Decimal(5, 2)
  /// Months of average salary the exemption is capped at. The section says 10.
  encashmentExemptMonths Decimal @default(10) @db.Decimal(5, 2)
  /// Encashment paid to a government employee is exempt in full.
  encashmentGovernmentEmployer Boolean @default(false)

  // ---- Investment proofs ----
  /// Whether a verified proof is required before a declared deduction reduces
  /// TDS. Off by default, so an existing installation keeps taking declarations
  /// at face value exactly as it did before proofs existed.
  proofVerificationRequired Boolean @default(false)
  /// The month from which verified amounts replace declared ones, 1 to 12.
  /// January by convention: declarations carry the year until proofs fall due.
  proofCutoffMonth Int @default(1)

  // ---- TDS (Income Tax Act, section 192) ----
  tdsEnabled       Boolean   @default(true)
  /// Applied to employees who have not chosen a regime themselves.
  defaultTaxRegime TaxRegime @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("statutory_configs")
}

/// Professional tax is a state levy with its own slabs. A few states vary the
/// amount by gender or charge a different figure in one month of the year.
model ProfessionalTaxSlab {
  id       String @id @default(uuid())
  tenantId String
  state    String @db.VarChar(50)

  /// Inclusive lower bound of monthly gross.
  fromAmount Decimal  @db.Decimal(12, 2)
  /// Inclusive upper bound; null means no upper bound.
  toAmount   Decimal? @db.Decimal(12, 2)
  /// Amount deducted in a normal month.
  amount     Decimal  @db.Decimal(10, 2)
  /// Maharashtra deducts a higher figure in February; null means no override.
  februaryAmount Decimal? @db.Decimal(10, 2)
  /// Restricts the slab to one gender where the state distinguishes; null = all.
  gender     String?  @db.VarChar(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, state])
  @@map("professional_tax_slabs")
}

/// Income tax parameters for one financial year and regime.
/// financialYear 2025 means FY 2025-26 (AY 2026-27).
model IncomeTaxConfig {
  id            String    @id @default(uuid())
  tenantId      String
  financialYear Int
  regime        TaxRegime
  /// Which basic-exemption band these slabs are for. The new regime does not
  /// vary by age; seed GENERAL for it.
  ageBand       TaxAgeBand @default(GENERAL)

  standardDeduction Decimal @default(0) @db.Decimal(12, 2)
  /// Section 87A: taxable income at or below which the rebate applies.
  rebateIncomeLimit Decimal @default(0) @db.Decimal(12, 2)
  /// Section 87A: the most the rebate can be worth.
  rebateMaxAmount   Decimal @default(0) @db.Decimal(12, 2)
  /// Health and education cess, percent of tax plus surcharge.
  cessRate          Decimal @default(4) @db.Decimal(5, 2)
  /// [{ "threshold": 5000000, "rate": 10 }, ...], applied to tax before cess.
  surchargeSlabs    Json    @default("[]")

  // ---- Chapter VI-A ceilings ----
  /// Statutory maxima. Held per year and regime because the Finance Act moves
  /// them. A declared, or even an approved, figure above these does not reduce
  /// tax, so the calculation caps rather than trusting what was entered.
  section80CLimit       Decimal @default(150000) @db.Decimal(12, 2)
  section80DLimit       Decimal @default(25000) @db.Decimal(12, 2)
  section80CCD1BLimit   Decimal @default(50000) @db.Decimal(12, 2)
  /// Section 10(14) monthly ceilings, per child, for at most two children.
  childrenEducationMonthlyLimit Decimal @default(100) @db.Decimal(10, 2)
  hostelAllowanceMonthlyLimit   Decimal @default(300) @db.Decimal(10, 2)
  /// The most children the section 10(14) allowances may be claimed for.
  childrenAllowanceMaxChildren  Int     @default(2)
  /// Whether marginal relief applies to surcharge. True in practice; held as
  /// data so a year that worked differently can still be seeded.
  marginalReliefEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  slabs  IncomeTaxSlab[]

  @@unique([tenantId, financialYear, regime, ageBand])
  @@index([tenantId])
  @@map("income_tax_configs")
}

model IncomeTaxSlab {
  id       String @id @default(uuid())
  configId String

  /// Inclusive lower bound of taxable income.
  fromAmount Decimal  @db.Decimal(14, 2)
  /// Inclusive upper bound; null means the top slab.
  toAmount   Decimal? @db.Decimal(14, 2)
  rate       Decimal  @db.Decimal(5, 2)

  config IncomeTaxConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@map("income_tax_slabs")
}

/// What an employee has declared for the year, used to project their tax.
/// These are declarations, not verified proofs; a proof-approval workflow is
/// not implemented.
model EmployeeTaxDeclaration {
  id            String    @id @default(uuid())
  tenantId      String
  employeeId    String
  financialYear Int
  regime        TaxRegime

  /// Chapter VI-A and exemptions. Only relevant under the old regime, except
  /// section 80CCD(2), which both regimes allow.
  section80C          Decimal @default(0) @db.Decimal(12, 2)
  section80D          Decimal @default(0) @db.Decimal(12, 2)
  section80CCD1B      Decimal @default(0) @db.Decimal(12, 2)
  section80CCD2       Decimal @default(0) @db.Decimal(12, 2)
  hraExemption        Decimal @default(0) @db.Decimal(12, 2)
  /// Section 10(5): leave travel concession actually spent on travel.
  ltaExemption        Decimal @default(0) @db.Decimal(12, 2)
  /// Section 10(14): children's education allowance, and hostel allowance.
  /// Both are capped per child for at most two children, and the ceiling is
  /// applied in the calculation rather than trusted from the declaration.
  childrenEducationAllowance Decimal @default(0) @db.Decimal(12, 2)
  hostelAllowance            Decimal @default(0) @db.Decimal(12, 2)
  /// How many children the two allowances above are claimed for. The section
  /// allows at most two, and the calculation caps it.
  childrenCount              Int     @default(0)
  homeLoanInterest    Decimal @default(0) @db.Decimal(12, 2)
  otherDeductions     Decimal @default(0) @db.Decimal(12, 2)
  /// Income declared from elsewhere, added to the projection.
  otherIncome         Decimal @default(0) @db.Decimal(12, 2)
  /// Tax already deducted by a previous employer this financial year.
  previousEmployerTds Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, employeeId, financialYear])
  @@index([tenantId])
  @@index([employeeId])
  @@map("employee_tax_declarations")
}

// ============================================
// EXIT SETTLEMENT
// ============================================

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

/// Full and final settlement for a leaver: what is still owed to them, what is
/// recovered, and what is actually paid out.
model Settlement {
  id           String           @id @default(uuid())
  tenantId     String
  separationId String           @unique
  employeeId   String
  status       SettlementStatus @default(DRAFT)

  /// Last working day the settlement was computed against.
  lastWorkingDate DateTime

  // ---- Payable ----
  /// Salary for the part-month worked up to the last working day.
  proRataSalary       Decimal @default(0) @db.Decimal(12, 2)
  /// Unused leave being encashed, its value, and the portion exempt under
  /// section 10(10AA). Exempt is a column rather than only a figure inside the
  /// breakdown so it can be totalled across settlements the way gratuity's is.
  leaveEncashmentDays   Decimal @default(0) @db.Decimal(6, 2)
  leaveEncashment       Decimal @default(0) @db.Decimal(12, 2)
  leaveEncashmentExempt Decimal @default(0) @db.Decimal(12, 2)
  /// Gratuity earned, and the portion exempt from tax.
  gratuity            Decimal @default(0) @db.Decimal(12, 2)
  gratuityExempt      Decimal @default(0) @db.Decimal(12, 2)
  /// Anything else the employer chooses to pay: bonus, reimbursement, ex gratia.
  otherEarnings       Decimal @default(0) @db.Decimal(12, 2)

  // ---- Recovered ----
  /// Days of notice not served, and the pay recovered for them.
  noticeShortfallDays Int     @default(0)
  noticeRecovery      Decimal @default(0) @db.Decimal(12, 2)
  /// Advances, asset losses, anything else withheld.
  otherRecoveries     Decimal @default(0) @db.Decimal(12, 2)

  // ---- Statutory ----
  tds Decimal @default(0) @db.Decimal(12, 2)

  grossPayable    Decimal @default(0) @db.Decimal(12, 2)
  totalRecoveries Decimal @default(0) @db.Decimal(12, 2)
  netPayable      Decimal @default(0) @db.Decimal(12, 2)

  /// How each figure was arrived at, so a leaver can be shown the working.
  breakdown Json?

  remarks    String?   @db.Text
  approvedBy String?
  approvedAt DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  separation Separation @relation(fields: [separationId], references: [id])
  employee   Employee   @relation("SettlementEmployee", fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@map("settlements")
}


// ============================================
// INVESTMENT PROOFS
// ============================================

/// Which basic-exemption band an individual falls in under the old regime.
///
/// Age is taken as at 31 March, the last day of the financial year, which is
/// how the Act reads. The new regime does not vary by age, so a tenant seeds
/// GENERAL rows for it and nothing else.
enum TaxAgeBand {
  /// Below 60.
  GENERAL
  /// 60 or above and below 80.
  SENIOR
  /// 80 or above.
  SUPER_SENIOR
}

enum InvestmentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The heads a proof can be filed under.
///
/// Only deductions evidence can support. Section 80CCD(2) is the employer's own
/// contribution and needs no proof from the employee, and declared other income
/// increases tax rather than reducing it, so neither appears here.
enum InvestmentProofSection {
  SECTION_80C
  SECTION_80D
  SECTION_80CCD1B
  HRA
  HOME_LOAN_INTEREST
  OTHER_DEDUCTIONS
  PREVIOUS_EMPLOYER_TDS
  /// Section 10(5): travel tickets for the leave travel concession.
  LTA
  /// Section 10(14): school fee receipts, and hostel bills.
  CHILDREN_EDUCATION
  HOSTEL_ALLOWANCE
}

/// One piece of evidence for one head, for one financial year.
///
/// An employee may file several against the same head; what counts is the sum
/// of the approved ones. The claimed amount is what the employee says the
/// document shows; the verified amount is what the reviewer accepted, and may
/// be lower.
model InvestmentProof {
  id            String                @id @default(uuid())
  tenantId      String
  employeeId    String
  /// FY 2026-27 is 2026.
  financialYear Int
  section       InvestmentProofSection
  status        InvestmentProofStatus @default(PENDING)

  /// What the employee says the document supports.
  claimedAmount  Decimal  @db.Decimal(12, 2)
  /// What the reviewer accepted. Null until a decision is recorded.
  verifiedAmount Decimal? @db.Decimal(12, 2)

  uploadId    String
  description String? @db.VarChar(500)

  reviewedBy String?
  reviewedAt DateTime?
  /// Why it was rejected, or a note on a partial approval. Required on refusal:
  /// an employee whose evidence is refused is owed a reason.
  reviewNote String? @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation("InvestmentProofEmployee", fields: [employeeId], references: [id])
  upload   Upload   @relation(fields: [uploadId], references: [id])

  /// One document per head per year. Two proofs pointing at the same upload
  /// under one head would both be summed once approved, inflating a deduction
  /// and under-deducting tax. The same document may still support a different
  /// head, which is why the section is part of the identity.
  @@unique([tenantId, employeeId, financialYear, section, uploadId])
  @@index([tenantId, financialYear])
  @@index([employeeId, financialYear])
  @@index([tenantId, status])
  @@map("investment_proofs")
}
