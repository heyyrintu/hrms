  pfEmployee      Decimal  @default(0) @db.Decimal(12, 2)
  pfEmployer      Decimal  @default(0) @db.Decimal(12, 2)
  epsEmployer     Decimal  @default(0) @db.Decimal(12, 2)
  edliEmployer    Decimal  @default(0) @db.Decimal(12, 2)
  pfAdminEmployer Decimal  @default(0) @db.Decimal(12, 2)
  esiWages        Decimal  @default(0) @db.Decimal(12, 2)
