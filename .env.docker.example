# Docker Compose environment template.
#
#   cp .env.docker.example .env.docker
#
# then fill in the three required values below. `docker compose` reads .env by
# default, so either name the file .env or pass --env-file .env.docker.
# Never commit the filled-in file: .env.docker and .env are both gitignored.

# ── Required ────────────────────────────────────────────────────────────────
# Compose refuses to start unless these are set.

# Database password. No fallback: a default would be a known credential.
POSTGRES_PASSWORD=

# Token signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Encrypts Aadhaar numbers at rest. Exactly 64 hex characters (32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this later requires re-encrypting existing rows.
FIELD_ENCRYPTION_KEY=

# ── Biometric devices ───────────────────────────────────────────────────────
# Source-IP allowlist for the unauthenticated /iclock push endpoint.
# Empty REJECTS every device push (fail closed). Comma-separated IPv4
# addresses and/or CIDR ranges, or "*" to deliberately accept any source.
BIOMETRIC_ALLOWED_IPS=

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=hrms
POSTGRES_DB=hrms
POSTGRES_PORT=5432
# Published interface. Loopback by default; set 0.0.0.0 to expose deliberately.
POSTGRES_BIND=127.0.0.1

# ── Redis ───────────────────────────────────────────────────────────────────
# Leave empty to run Redis without authentication (loopback only).
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_BIND=127.0.0.1

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
JWT_EXPIRES_IN=7d
DEFAULT_TENANT_ID=dev-tenant-001
BACKEND_PORT=3001
FRONTEND_PORT=3000
CORS_ORIGIN=http://localhost:3000
STORAGE_TYPE=local

# Baked into the frontend image at build time. Changing it needs a rebuild:
#   docker compose up --build -d
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_NAME=HRMS

# ── Email (optional) ────────────────────────────────────────────────────────
# Microsoft Graph is preferred when set; otherwise SMTP; otherwise emails are
# logged to the console only.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HRMS <noreply@hrms.local>
